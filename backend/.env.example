# Copia este archivo como .env y ajusta los valores.

NODE_ENV=development
PORT=3000
# Orígenes del frontend permitidos (separados por coma)
CORS_ORIGINS=http://localhost:4200
# true si la API corre detrás de un proxy (nginx, panel de Hostinger, etc.)
TRUST_PROXY=false

# --- Base de datos MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=bienestar
DB_PASSWORD=bienestar
DB_NAME=bienestar_moral
DB_CONNECTION_LIMIT=10
# Aplica migraciones automáticamente al arrancar
DB_MIGRATE_ON_START=true

# --- Autenticación del panel de administración
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-48-bytes
JWT_EXPIRES_IN=8h
# Administrador inicial: se crea al arrancar si no existe (mínimo 10 caracteres de contraseña)
ADMIN_EMAIL=admin@bienestarmoral.org
ADMIN_PASSWORD=cambia-esta-clave

# --- Almacenamiento de archivos
# local = carpeta ./storage/public servida en /uploads (desarrollo)
# ftp   = Hostinger por FTP/FTPS (producción)
STORAGE_DRIVER=local
# URL pública de la carpeta de archivos. En local se deduce sola.
# PUBLIC_FILES_BASE_URL=https://tudominio.com/uploads
LOCAL_STORAGE_DIR=./storage/public

# Hostinger: hPanel > Archivos > Cuentas FTP
# FTP_HOST=ftp.tudominio.com
# FTP_PORT=21
# FTP_USER=u123456789
# FTP_PASSWORD=
# true = FTPS explícito (recomendado), false = FTP plano, implicit = FTPS implícito
# FTP_SECURE=true
# Carpeta relativa al inicio de la cuenta FTP; debe quedar dentro de public_html para ser pública
# FTP_BASE_DIR=public_html/uploads
# FTP_TIMEOUT_MS=30000

# --- Worker de archivos
FILE_WORKERS=2
FILE_JOB_TIMEOUT_MS=120000
DOWNLOAD_CACHE_DIR=./storage/cache
MAX_IMAGE_SIZE_MB=5
MAX_DOCUMENT_SIZE_MB=20
